{
  "manifest_version": 2,
  "name": "Save to Markdown",
  "version": "1.0.2",
  "description": "Append a link or page to your local vault Index.md.",
  "permissions": [
    "menus",
    "nativeMessaging",
    "activeTab",
    "notifications"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "save-to-markdown@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
